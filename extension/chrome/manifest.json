{
  "manifest_version": 3,
  "name": "HiveMind Agent Hive",
  "version": "0.2.0",
  "description": "O Agent Hive controla o Chrome real, com a sua sessão, sob aprovação do HiveMind.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["debugger", "tabs", "scripting", "activeTab", "sidePanel", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Agent Hive",
    "default_icon": "icon.png"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Abrir o chat do Agent Hive"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
