# Copie para /etc/hivemind-relay.env e faça chmod 600.
# Não commite senha.

HIVEMIND_RELAY_ADDR=127.0.0.1:8787
HIVEMIND_RELAY_DATA=/var/lib/hivemind-relay
HIVEMIND_RELAY_PUBLIC_URL=https://relay.example.com
HIVEMIND_SEED_EMAIL=owner@example.com
# Vazio = o processo gera uma senha e imprime uma vez.
HIVEMIND_SEED_PASSWORD=
